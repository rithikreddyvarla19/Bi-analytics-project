# Core runtime
PYTHONPATH=.
ENV=dev

# Postgres simulation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retail_warehouse
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail

# Local lakehouse root
LAKEHOUSE_ROOT=./data

# AWS placeholders for deployment
AWS_REGION=us-east-1
S3_BRONZE_BUCKET=retail-lakehouse-bronze-dev
S3_SILVER_BUCKET=retail-lakehouse-silver-dev
S3_GOLD_BUCKET=retail-lakehouse-gold-dev
REDSHIFT_DATABASE=retail_analytics
REDSHIFT_USER=analytics_user
